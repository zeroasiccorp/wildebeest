# yosys -m wildebeest -s mae-techmap-efpga_mult_rego_partial_pack_mirror.ys
#
# The mirror of mae-techmap-efpga_mult_rego_partial_pack.ys: the multiply's
# SECOND operand is the registered one, so the flop lands on the macro's 'b'
# port and ffB matches without ffA.
#
# Both orders are pinned because which operand reaches which macro port is a
# 'mul2dsp' decision and not a property of the design.  The two are not
# symmetric in the pass -- one of them was already handled and the other was
# not -- so a single file would pin whichever side happens to be lucky.
read_verilog <<EOF
module efpga_mult_rego_partial_pack_mirror_map_inst
  # (
     parameter INPUT_WIDTH = 18,
     parameter OUTPUT_WIDTH = 36
     )
   (
    input                                   clk,
    input                                   resetn,
    input signed [(INPUT_WIDTH-1):0]        a,
    input signed [(INPUT_WIDTH-1):0]        b,
    output reg signed [(OUTPUT_WIDTH-1):0]  y
    );

   reg signed [(INPUT_WIDTH-1):0] b_reg;

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         b_reg <= 'h0;
      end
      else begin
         b_reg <= b;
      end
   end

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         y <= 'h0;
      end
      else begin
         y <= a * b_reg;
      end
   end

endmodule
EOF

synth_fpga -partname z1010
select -assert-count 1 */t:efpga_mult_rego
select -assert-count 1 */t:efpga_mult_rego %x:+[resetn] */w:resetn %i
select -assert-count 1 */t:efpga_mult_rego %x:+[clk] */w:clk %i
select -assert-count 0 */t:efpga_mult_regio
select -assert-count 0 */t:efpga_mult_regi
select -assert-min 1 */t:dffr
