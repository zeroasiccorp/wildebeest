# An active-high async reset on the adder output register is packed.

read_verilog <<EOF
module top (input clk, rst, input signed [17:0] a, b, output reg signed [19:0] y);
   always @(posedge clk or posedge rst) if (rst) y <= 0; else y <= a + b;
endmodule
EOF
synth_fpga -partname z1010
select -assert-count 1 t:efpga_adder_rego
select -assert-count 1 t:efpga_*
select -assert-none t:dff*
