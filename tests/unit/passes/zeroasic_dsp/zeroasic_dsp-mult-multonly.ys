# With the scratchpad flag zeroasic_dsp.multonly set, nothing is packed
# around the multiplier.

read_verilog <<EOF
module top (input clk, input signed [17:0] a, b, output reg [35:0] y);
   always @(posedge clk) y <= a * b;
endmodule
EOF
scratchpad -set zeroasic_dsp.multonly 1
synth_fpga -partname z1010
select -assert-count 1 t:efpga_mult
select -assert-count 1 t:efpga_*
select -assert-count 36 t:dff*
