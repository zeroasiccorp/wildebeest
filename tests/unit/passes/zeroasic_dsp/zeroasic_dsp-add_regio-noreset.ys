# Adder input and output registers without reset are packed.

read_verilog <<EOF
module top (input clk, input signed [17:0] a, b, output reg signed [19:0] y);
   reg signed [17:0] ar, br;
   always @(posedge clk) begin ar <= a; br <= b; y <= ar + br; end
endmodule
EOF
synth_fpga -partname z1010
select -assert-count 1 t:efpga_adder_regio
select -assert-count 1 t:efpga_*
select -assert-none t:dff*
