# An init value of 0 on the adder output register is accepted and cleared.

read_verilog <<EOF
module top (input clk, input signed [17:0] a, b, output reg signed [19:0] y);
   initial y = 20'h00000;
   always @(posedge clk) y <= a + b;
endmodule
EOF
synth_fpga -partname z1010
select -assert-count 1 t:efpga_adder_rego
select -assert-count 1 t:efpga_*
select -assert-none t:dff*
