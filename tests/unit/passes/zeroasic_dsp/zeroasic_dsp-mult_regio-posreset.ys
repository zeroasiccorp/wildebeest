# Active-high async resets are packed through an inverter on resetn.

read_verilog <<EOF
module top (input clk, rst, input signed [17:0] a, b, output reg [35:0] y);
   reg signed [17:0] ar, br;
   always @(posedge clk or posedge rst)
     if (rst) begin ar <= 0; br <= 0; y <= 0; end
     else begin ar <= a; br <= b; y <= ar * br; end
endmodule
EOF
synth_fpga -partname z1010
select -assert-count 1 t:efpga_mult_regio
select -assert-count 1 t:efpga_*
select -assert-none t:dff*
