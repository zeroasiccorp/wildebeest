# -opt delay -no_xor_tree_process: ABC still runs its delay script, without
# the XOR-tree rebalancing.  Proven equivalent to the RTL.

read_verilog ../../data/designs/xor_tree.v
proc
design -save rtl

logger -expect log "Calling ABC script in 'tiny_delay' mode" 1
synth_fpga -opt delay -no_xor_tree_process
logger -check-expected

rename top gate
design -copy-from rtl -as gold top
miter -equiv -flatten -make_assert gold gate miter
sat -verify -prove-asserts miter
