# yosys -m wildebeest -s heartbeat-z1010-hardcode-real.ys
#
# Hardcoded (no -config) z1010 flow.  heartbeat-z1010-hardcode.ys, despite its
# name, runs '-partname z1000' (KNOWN-ISSUE SF13) and is kept as is for the
# z1000 path.  The cell counts are the same for both parts, so the z1010-only
# MAE model load is asserted to prove which path ran.
read_verilog <<EOF
module heartbeat #(
    parameter N = 8
) (
    //inputs
    input      clk,     // clock
    input      nreset,  //async active low reset
    //outputs
    output reg out      //heartbeat
);

    reg [N-1:0] counter_reg;

    always @(posedge clk or negedge nreset) begin
        if (!nreset) begin
            counter_reg <= {(N) {1'b0}};
            out <= 1'b0;
        end else begin
            counter_reg <= counter_reg + 1'b1;
            out <= (counter_reg == {(N) {1'b1}});
        end
    end

endmodule
EOF

logger -expect log "Executing Verilog-2005 frontend: .*/architecture/z1010/models/tech_mae.v" 1
synth_fpga -partname z1010
select -assert-count 9 */t:dffr
select -assert-count 11 */t:$lut
select -assert-count 20 */t:*
