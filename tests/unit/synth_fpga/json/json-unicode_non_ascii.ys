# \uXXXX escapes of 128 and above are refused.
# Fixture: data/config/json-unicode_non_ascii.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "Unsupported " 1
synth_fpga -config ../../data/config/json-unicode_non_ascii.json
