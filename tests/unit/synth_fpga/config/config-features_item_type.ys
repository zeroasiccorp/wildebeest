# 'flipflops.features' items must be strings.
# Fixture: data/config/config-features_item_type.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "Array associated to DFF 'features' must contain only strings." 1
synth_fpga -config ../../data/config/config-features_item_type.json
