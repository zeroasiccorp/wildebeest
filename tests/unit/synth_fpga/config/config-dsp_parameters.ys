# dsps.techmap_parameters accepts strings and
# integers, and pack_command is any yosys command (here opt_clean).
# Fixture: data/config/config-dsp_parameters.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

synth_fpga -config ../../data/config/config-dsp_parameters.json
logger -check-expected
select -assert-min 1 t:$lut
