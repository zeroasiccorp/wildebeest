# 'flipflops.techmap' must be a string.
# Fixture: data/config/config-ff_techmap_type.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "'techmap' associated to 'flipflops' must be a string." 1
synth_fpga -config ../../data/config/config-ff_techmap_type.json
