# With no flip-flop features listed, one warning per
# missing feature.  KNOWN-ISSUE SF9: the wording (and logic) is inverted:
# a missing feature 'switches off' the option that disables it.
# Fixture: data/config/config-features_empty.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect warning "Config file will switch off '-no_dff_async_reset' option." 1
logger -expect warning "Config file will switch on '-dff_async_set' option." 1
logger -expect warning "Config file will switch off '-no_dff_enable' option." 1
synth_fpga -config ../../data/config/config-features_empty.json
logger -check-expected
select -assert-min 1 t:$lut
