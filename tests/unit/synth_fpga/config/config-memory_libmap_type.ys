# 'brams.memory_libmap' must be an array.
# Fixture: data/config/config-memory_libmap_type.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "'memory_libmap' associated to 'brams' must be an array." 1
synth_fpga -config ../../data/config/config-memory_libmap_type.json
