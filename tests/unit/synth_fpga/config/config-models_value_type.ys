# 'flipflops.models' values must be strings.
# Fixture: data/config/config-models_value_type.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "Second element associated to DFF models 'dff' must be a string." 1
synth_fpga -config ../../data/config/config-models_value_type.json
