# A BRAM techmap without memory_libmap: warns at
# BRAM inference and skips it.
# Fixture: data/config/config-brams_techmap_only.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect warning "'memory_libmap' from 'brams' is missing in config file '" 1
synth_fpga -config ../../data/config/config-brams_techmap_only.json
logger -check-expected
select -assert-min 1 t:$lut
