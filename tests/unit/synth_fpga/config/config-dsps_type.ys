# 'dsps' must be a dictionary.
# Fixture: data/config/config-dsps_type.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "'dsps' must be a dictionnary." 1
synth_fpga -config ../../data/config/config-dsps_type.json
