# The root value must be a dictionary.
# Fixture: data/config/config-not_a_dict.json

read_verilog <<EOF
module top (input clk, nreset, input [3:0] d, output reg [3:0] q);
   always @(posedge clk or negedge nreset)
      if (!nreset) q <= 4'b0000;
      else q <= q + d;
endmodule
EOF

logger -expect error "file is not a dictionary." 1
synth_fpga -config ../../data/config/config-not_a_dict.json
