# yosys -m wildebeest -s mae-techmap-efpga_mult_addc_rego_partial_pack.ys
#
# The same partial pack as mae-techmap-efpga_mult_rego_partial_pack.ys, with the
# post-adder in it, which is the mode the defect was reported on:
# 'efpga_mult_addc_rego' held an undriven 'resetn' on 61 benchmarks of an
# FPGA Architect weekly run, all of them a variable-width MACC whose pre-adder
# feeds one multiplier operand while the other comes out of a register.
#
# Kept separate from the plain 'rego' file because the post-adder changes which
# arm of 'zeroasic_dsp_map_mode.v' picks the mode, and the reset is assigned
# before that: a fix that works for one mode and not the other would pass one of
# these two files.
read_verilog <<EOF
module efpga_mult_addc_rego_partial_pack_map_inst
  # (
     parameter INPUT_WIDTH = 18,
     parameter OUTPUT_WIDTH = 40,
     localparam C_WIDTH = OUTPUT_WIDTH
     )
   (
    input                                   clk,
    input                                   resetn,
    input signed [(INPUT_WIDTH-1):0]        a,
    input signed [(INPUT_WIDTH-1):0]        b,
    input signed [(C_WIDTH-1):0]            c,
    output reg signed [(OUTPUT_WIDTH-1):0]  y
    );

   reg signed [(INPUT_WIDTH-1):0] a_reg;

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         a_reg <= 'h0;
      end
      else begin
         a_reg <= a;
      end
   end

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         y <= 'h0;
      end
      else begin
         y <= (a_reg * b) + c;
      end
   end

endmodule
EOF

synth_fpga -partname z1010
select -assert-count 1 */t:efpga_mult_addc_rego
select -assert-count 1 */t:efpga_mult_addc_rego %x:+[resetn] */w:resetn %i
select -assert-count 1 */t:efpga_mult_addc_rego %x:+[clk] */w:clk %i
select -assert-count 1 */t:efpga_mult_addc_rego %x:+[c] */w:c %i
# The single registered operand is not packed, so the mode stays 'rego' and the
# flops stay in the fabric.
select -assert-count 0 */t:efpga_mult_addc_regio
select -assert-count 0 */t:efpga_mult_addc_regi
select -assert-min 1 */t:dffr
