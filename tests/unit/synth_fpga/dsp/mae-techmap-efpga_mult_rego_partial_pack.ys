# yosys -m wildebeest -s mae-techmap-efpga_mult_rego_partial_pack.ys
#
# A MAE that swallows the output register must have 'resetn' driven, whatever
# happened to the operand registers.
#
# 'zeroasic_dsp' packs the input registers only when BOTH operands are
# registered ('efpga_mult_regi' and 'efpga_mult_regio' register 'a' and 'b' out
# of the same flops, so one registered operand is not a mode we have), and the
# .pmg matches ffA and ffB independently.  A multiplier with one registered
# operand and one combinational one -- what a pre-adder feeding a multiplier
# looks like -- therefore matches ffA without ffB, and the A/B block does not
# run.  When the output register is packed on top of that, 'resetn' has to come
# from ffP instead, and the guard that does so has to test the whole A/B
# condition rather than ffA alone.
#
# Testing ffA alone left the cell holding the unconnected 'MAE.resetn' port.
# Nothing in synthesis complains: the netlist reads back with a wire that no
# cell drives, and it is the place and route tool that falls over -- VPR indexes
# 'pin_net_indices_' at -1 on a net with no driver and dies as
# 'free(): invalid pointer', naming neither the cell nor the net.
#
# 'a_reg' is the multiply's first operand here and lands on the macro's 'a'
# port; the mirror case is mae-techmap-efpga_mult_rego_partial_pack_mirror.ys.
read_verilog <<EOF
module efpga_mult_rego_partial_pack_map_inst
  # (
     parameter INPUT_WIDTH = 18,
     parameter OUTPUT_WIDTH = 36
     )
   (
    input                                   clk,
    input                                   resetn,
    input signed [(INPUT_WIDTH-1):0]        a,
    input signed [(INPUT_WIDTH-1):0]        b,
    output reg signed [(OUTPUT_WIDTH-1):0]  y
    );

   reg signed [(INPUT_WIDTH-1):0] a_reg;

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         a_reg <= 'h0;
      end
      else begin
         a_reg <= a;
      end
   end

   always @(posedge clk or negedge resetn) begin
      if (~resetn) begin
         y <= 'h0;
      end
      else begin
         y <= a_reg * b;
      end
   end

endmodule
EOF

synth_fpga -partname z1010
select -assert-count 1 */t:efpga_mult_rego
select -assert-count 1 */t:efpga_mult_rego %x:+[resetn] */w:resetn %i
select -assert-count 1 */t:efpga_mult_rego %x:+[clk] */w:clk %i
# The single registered operand is not packed, so the mode stays 'rego' and the
# flops stay in the fabric.
select -assert-count 0 */t:efpga_mult_regio
select -assert-count 0 */t:efpga_mult_regi
select -assert-min 1 */t:dffr
