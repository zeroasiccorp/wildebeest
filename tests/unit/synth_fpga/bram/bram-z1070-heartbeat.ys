# yosys -m wildebeest -s bram-z1070-heartbeat.ys
#
# 'z1070' is 'z1060' plus an init-capable BRAM library, so on a design with no
# memory in it the two parts must give identical results.  This is what catches
# a 'z1070' that was added to the part name list but not to the flop
# legalization or DSP setup : the BRAM tests would still pass, and every design
# without a memory would quietly fall back to the generic setup.
#
# The counts are the ones 'z1060' produces for this design.

read_verilog <<VEOF
module heartbeat #(
    parameter N = 8
) (
    input      clk,
    input      nreset,
    output reg out
);

   reg [N-1:0] counter_reg;

   always @(posedge clk or negedge nreset) begin
      if (!nreset) begin
         counter_reg <= {(N) {1'b0}};
         out <= 1'b0;
      end else begin
         counter_reg <= counter_reg + 1'b1;
         out <= (counter_reg == {(N) {1'b1}});
      end
   end

endmodule
VEOF

synth_fpga -partname z1070

select -assert-count 9 */t:dffr
select -assert-count 11 */t:$lut
