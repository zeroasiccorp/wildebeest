# yosys -m wildebeest -s carrychain-techmap-add_signed.ys

#A signed adder maps onto the hard carry chain just like the unsigned one :
#the sign extension is absorbed by the '$pos' conversions of the techmap.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_add_signed
  # (
     parameter WIDTH = 8
     )
   (
    input signed [(WIDTH-1):0] a,
    input signed [(WIDTH-1):0] b,
    output signed [WIDTH:0]    y
    );

   assign y = a + b;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain.json

#The whole adder is in the carry chain : no '$alu' survived and no soft
#logic was needed.
select -assert-count 9 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 0 */t:$lut
