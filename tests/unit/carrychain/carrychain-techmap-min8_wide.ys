# yosys -m wildebeest -s carrychain-techmap-min8_wide.ys

#Same techmap as 'carrychain-techmap-min8_narrow' : an adder that is wide
#enough must be accepted and fully mapped onto the hard carry chain.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_min8_wide
  # (
     parameter WIDTH = 8
     )
   (
    input [(WIDTH-1):0] a,
    input [(WIDTH-1):0] b,
    output [WIDTH:0]    y
    );

   assign y = a + b;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain_min8.json

#The whole adder is in the carry chain : no '$alu' survived and no soft
#logic was needed.
select -assert-count 9 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 0 */t:$lut
