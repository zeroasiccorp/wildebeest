# yosys -m wildebeest -s carrychain-techmap-wide_add.ys

#A 32 bit adder exercises a long carry chain : 33 result bits, 33 hard carry
#cells and no soft logic.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_wide_add
  # (
     parameter WIDTH = 32
     )
   (
    input [(WIDTH-1):0] a,
    input [(WIDTH-1):0] b,
    output [WIDTH:0]    y
    );

   assign y = a + b;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain.json

#The whole adder is in the carry chain : no '$alu' survived and no soft
#logic was needed.
select -assert-count 33 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 0 */t:$lut
