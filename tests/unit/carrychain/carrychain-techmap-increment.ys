# yosys -m wildebeest -s carrychain-techmap-increment.ys

#An incrementer is an '$alu' with a constant operand : it must be mapped onto
#the hard carry chain rather than onto soft logic.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_increment
  # (
     parameter WIDTH = 8
     )
   (
    input [(WIDTH-1):0]  a,
    output [(WIDTH-1):0] y
    );

   assign y = a + 1'b1;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain.json

#The whole adder is in the carry chain : no '$alu' survived and no soft
#logic was needed.
select -assert-count 8 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 0 */t:$lut
