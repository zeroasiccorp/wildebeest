# yosys -m wildebeest -s carrychain-techmap-with_no_dsp.ys

#'-no_dsp' disables DSP inference only : the multiply falls back to soft
#logic while the adder must still be mapped onto the hard carry chain.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_with_no_dsp
  # (
     parameter WIDTH = 8
     )
   (
    input [(WIDTH-1):0]    a,
    input [(WIDTH-1):0]    b,
    input [(WIDTH-1):0]    c,
    input [(WIDTH-1):0]    d,
    output [(2*WIDTH-1):0] p,
    output [WIDTH:0]       s
    );

   assign p = a * b;
   assign s = c + d;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain_dsp.json -no_dsp

select -assert-count 0 */t:DSP48
select -assert-count 9 */t:efpga_carry
select -assert-count 0 */t:$alu

#The multiply is the only thing left in soft logic.
select -assert-min 1 */t:$lut
