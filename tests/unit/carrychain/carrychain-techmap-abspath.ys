# yosys -m wildebeest -s carrychain-techmap-abspath.ys

#The adder techmap path is resolved against 'root_path' like every other
#techmap path : the leading '/' form must resolve the same way (same idea as
#'heartbeat-z1010-config-abspath.ys').

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_abspath
  # (
     parameter WIDTH = 8
     )
   (
    input [(WIDTH-1):0] a,
    input [(WIDTH-1):0] b,
    output [WIDTH:0]    y
    );

   assign y = a + b;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain_abspath.json

#The whole adder is in the carry chain : no '$alu' survived and no soft
#logic was needed.
select -assert-count 9 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 0 */t:$lut
