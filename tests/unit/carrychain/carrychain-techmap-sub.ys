# yosys -m wildebeest -s carrychain-techmap-sub.ys

#A subtraction is an '$alu' with 'BI' (invert B) asserted and a carry in tied
#to one : the arithmetic must still land on the hard carry chain, only the
#operand inversion is left to soft logic.

read_verilog -lib ../data/carrychain/models/tech_carry.v

read_verilog <<EOF
module carrychain_sub
  # (
     parameter WIDTH = 8
     )
   (
    input [(WIDTH-1):0]  a,
    input [(WIDTH-1):0]  b,
    output [(WIDTH-1):0] y
    );

   assign y = a - b;

endmodule
EOF

synth_fpga -config ../data/carrychain/carrychain.json

select -assert-count 8 */t:efpga_carry
select -assert-count 0 */t:$alu
select -assert-count 8 */w:a %co */t:efpga_carry %i
